pkgname=omamounter
pkgver=0.2.2
pkgrel=1
pkgdesc='Native Qt manager for NFS and SMB network shares'
arch=('x86_64')
license=('MIT')
depends=('qt6-base' 'libsecret' 'polkit' 'nfs-utils' 'cifs-utils' 'smbclient')
makedepends=('cmake' 'ninja' 'gcc')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$srcdir/$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
